{
  "name": "ae-catalogue-search",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4300",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev -p 4300",
    "build": "next build",
    "start": "next start -p ${PORT:-4300}",
    "export": "cross-env NEXT_STATIC_EXPORT=true next build",
    "postbuild": "node -e \"require('fs').existsSync('out') && console.log('Static export ready in ./out')\"",
    "electron:dev": "concurrently \"npm:dev\" \"wait-on http://localhost:4300 && electron electron/main.js\"",
    "electron:build": "cross-env NEXT_STATIC_EXPORT=true next build && electron-builder"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.9.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "autoprefixer": "10.4.20",
    "fuse.js": "7.0.0",
    "html2canvas": "^1.4.1",
    "imapflow": "^1.3.3",
    "jspdf": "^4.2.1",
    "mailparser": "^3.9.8",
    "next": "15.5.16",
    "nodemailer": "^8.0.7",
    "pdfjs-dist": "^4.10.38",
    "postcss": "8.4.49",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "22.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "cross-env": "^7.0.3",
    "typescript": "5.7.2"
  },
  "optionalDependencies": {
    "concurrently": "9.1.0",
    "electron": "33.3.1",
    "electron-builder": "25.1.8",
    "wait-on": "8.0.1"
  }
}
