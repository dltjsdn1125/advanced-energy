# OpenAI API Key — used by /api/ai/translate and /api/ai/reply
# Users can also provide this via the Settings UI in the app
OPENAI_API_KEY=sk-your-openai-key-here

# CORS allowed origins (comma-separated) — set in Railway dashboard
# ALLOWED_ORIGINS=https://your-app.up.railway.app

# Node environment (set automatically by Railway)
NODE_ENV=production

# ── Part Price Comparison ────────────────────────────────────────────────────
# Octopart (Altium Nexar) Supply API — 1순위 소스.
# nexar.com/api 에서 무료 가입 → 앱 생성(Supply scope) → Authorization 탭의
# Client ID / Secret 를 아래에 넣는다. (토큰은 자동 발급/캐시)
NEXAR_CLIENT_ID=your-nexar-client-id
NEXAR_CLIENT_SECRET=your-nexar-client-secret
# (선택) 재고/가격 기준 국가·통화
# NEXAR_COUNTRY=US
# NEXAR_CURRENCY=USD

# TrustedParts.com Inventory API — Nexar 자격 증명이 없을 때 폴백으로 사용.
# TRUSTEDPARTS_COMPANY_ID=...
# TRUSTEDPARTS_API_KEY=...
# TRUSTEDPARTS_COUNTRY=US
